# Bhashara .gitignore

# ==============================================================================
# 1. Secrets and sensitive files
# ==============================================================================
.env
.env.*
*.env
*.token
*token*
*.key
*.pem
*.pfx
*.p12
hf_token*
secrets/
credentials/
passwords*
auth*

# ==============================================================================
# 2. Virtual environments, package caches, and compiled files
# ==============================================================================
.venv/
venv/
env/
ENV/
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.dylib
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/
dist/
build/
*.egg-info/

# ==============================================================================
# 3. Model weights and downloads
# ==============================================================================
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
models/
checkpoints/
.cache/
huggingface/
torch_cache/

# ==============================================================================
# 4. Generated and heavy media, test outputs, and binaries
# ==============================================================================
cache/
cache_*/
proof/
output/
stems/
tests/test_workspace/
tests/test_data/
*.tmp
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.ogg
*.srt
*.vtt

# Heavy bundled binaries (download via setup script)
tools/
tools/*.exe

# ==============================================================================
# 5. Logs and system junk
# ==============================================================================
*.log
run_log.txt
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
